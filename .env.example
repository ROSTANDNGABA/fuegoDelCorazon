# Variables d'environnement pour Student Matching
# Copiez ce fichier en .env et remplissez les valeurs

# Configuration Django
SECRET_KEY=votre-secret-key-tres-securisee-ici
DEBUG=False
ALLOWED_HOSTS=votredomaine.com,www.votredomaine.com

# Configuration de la base de données PostgreSQL
DB_NAME=student_matching
DB_USER=postgres
DB_PASSWORD=votre-mot-de-passe-db
DB_HOST=localhost
DB_PORT=5432

# Configuration Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-app
DEFAULT_FROM_EMAIL=noreply@votredomaine.com

# Configuration HTTPS (décommentez en production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Configuration des fichiers
STATIC_ROOT=/path/to/your/static/files
MEDIA_ROOT=/path/to/your/media/files
